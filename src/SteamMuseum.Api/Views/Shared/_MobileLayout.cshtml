<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <title>Steam Museum · Staff sign-in</title>
    <style>
        *{box-sizing:border-box}body{margin:0;background:#f6f7f3;color:#243d36;font:16px/1.6 system-ui,sans-serif}main{max-width:480px;margin:6vh auto;padding:32px;background:white;border:1px solid #d8dfd6;border-radius:12px}h1{line-height:1.2;font-size:28px}label{display:block;margin-top:18px}input{width:100%;padding:12px;border:1px solid #becac1;border-radius:6px;font:inherit}button{margin-top:24px;background:#285943;color:white;border:0;border-radius:6px;padding:12px 18px;font:inherit;cursor:pointer}.validation-summary-errors{color:#9d392b}a{color:#285943}input:focus-visible,button:focus-visible{outline:3px solid #b48a35;outline-offset:3px}small{color:#62756a}
    </style>
</head>
<body><main><small>STEAM MUSEUM · STAFF</small>@RenderBody()</main></body>
</html>
