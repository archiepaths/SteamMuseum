@model SteamMuseum.Api.MobilePasswordModel
@{ Layout = "_MobileLayout"; }
<h1>Choose your own password</h1>
<p>Change your temporary password before continuing. Use at least 12 characters including uppercase, lowercase, a number and a symbol.</p>
<form method="post" action="/mobile/password">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" role="alert"></div>
    <input type="hidden" asp-for="ReturnUrl" />
    <label asp-for="CurrentPassword">Current password</label><input asp-for="CurrentPassword" type="password" autocomplete="current-password" required maxlength="256" />
    <label asp-for="NewPassword">New password</label><input asp-for="NewPassword" type="password" autocomplete="new-password" required minlength="12" maxlength="256" />
    <label asp-for="ConfirmPassword">Confirm new password</label><input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required maxlength="256" />
    <button type="submit">Change password and continue</button>
</form>
