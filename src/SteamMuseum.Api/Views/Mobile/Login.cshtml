@model SteamMuseum.Api.MobileLoginModel
@{ Layout = "_MobileLayout"; }
<h1>Sign in to the staff app</h1>
<p>Use your museum staff account. Your password stays on this sign-in page.</p>
<form method="post" action="/mobile/login">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" role="alert"></div>
    <input type="hidden" asp-for="ReturnUrl" />
    <label asp-for="Email">Email address</label><input asp-for="Email" type="email" autocomplete="username" required maxlength="256" />
    <label asp-for="Password">Password</label><input asp-for="Password" type="password" autocomplete="current-password" required maxlength="256" />
    <button type="submit">Sign in</button>
</form>
<p><small>For account access or a password reset, contact your museum administrator.</small></p>
